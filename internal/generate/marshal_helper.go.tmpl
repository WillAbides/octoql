{{/* This is somewhat parallel to unmarshal_helper.go.tmpl, but, as usual, in
     reverse.  Note the helper accepts a pointer-to-interface, for
     consistency with unmarshaling. */}}

func _octoqlMarshal{{.GoName}}(v *{{.GoName}}) ([]byte, error) {
    switch vv := (*v).(type) {
    {{range .Implementations -}}
    case *{{.GoName}}:
        if vv == nil {
            return []byte("null"), nil
        }

        {{/* Now actually do the marshal, with the concrete type. (Go only
             marshals embeds the way we want if they're structs.)  Except that
             won't work right if the implementation-type has its own
             MarshalJSON method (maybe it in turn has an interface-typed
             field), so we call the helper _octoqlPremarshalJSON directly (see
             marshal.go.tmpl). */}}
        {{if .NeedsMarshaling -}}
        premarshaled, err := vv._octoqlPremarshalJSON()
        if err != nil {
            return nil, err
        }
        result := struct {
            TypeName string `json:"__typename"`
            *_octoqlPremarshal{{.GoName}}
        }{
            TypeName: "{{.GraphQLName}}",
            _octoqlPremarshal{{.GoName}}: premarshaled,
        }
        {{else -}}
        result := struct {
            TypeName string `json:"__typename"`
            *{{.GoName}}
        }{
            TypeName: "{{.GraphQLName}}",
            {{.GoName}}: vv,
        }
        {{end -}}
        return {{ref "encoding/json.Marshal"}}(result)
    {{end -}}
    case *{{.OtherImplementation.GoName}}:
        if vv == nil {
            return []byte("null"), nil
        }
        {{if .OtherImplementation.NeedsMarshaling -}}
        premarshaled, err := vv._octoqlPremarshalJSON()
        if err != nil {
            return nil, err
        }
        return {{ref "encoding/json.Marshal"}}(premarshaled)
        {{else -}}
        return {{ref "encoding/json.Marshal"}}(vv)
        {{end -}}
    case nil:
        return []byte("null"), nil
    default:
        return nil, {{ref "fmt.Errorf"}}(
            `unexpected concrete type for {{.GoName}}: "%T"`, vv)
    }
}
