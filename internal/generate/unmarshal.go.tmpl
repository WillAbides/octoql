{{/* We need to generate UnmarshalJSONFrom methods for some types that we want
     to handle specially.  Specifically, we generate an UnmarshalJSONFrom for
     each struct with a field meeting any of these criteria:
        - an embedded (anonymous) field, so every embedded fragment struct is
          populated even when fields overlap across the struct and its embeds
        - a field of interface type
     Additionally, since we add `json:"-"` to fields we handle specially, for
     any field which requires a MarshalJSONTo, we also generate an
     UnmarshalJSONFrom, and vice versa.

     For our first pass, we decode all non-embedded fields (registering
     type-specific unmarshalers for any interface-typed fields so encoding/json/v2
     handles arbitrary slice nesting directly), then unmarshal the input again
     into each embedded field. */}}

func (v *{{.GoName}}) UnmarshalJSONFrom(dec *{{ref "encoding/json/jsontext.Decoder"}}) error {
    {{- $hasEmbedded := false -}}
    {{- $hasNonEmbedded := false -}}
    {{- $hasInterfaces := false -}}
    {{- range .Fields -}}
    {{- if .IsEmbedded -}}
    {{- $hasEmbedded = true -}}
    {{- else -}}
    {{- $hasNonEmbedded = true -}}
    {{- if .NeedsMarshaling -}}{{- $hasInterfaces = true -}}{{- end -}}
    {{- end -}}
    {{- end }}

    {{if not $hasEmbedded -}}
    if dec.PeekKind() == 'n' {
        _, err := dec.ReadToken()
        return err
    }

    return {{ref "encoding/json/v2.UnmarshalDecode"}}(
        dec,
        (*_octoqlPremarshal{{.GoName}})(v),
        {{if $hasInterfaces -}}
        {{ref "encoding/json/v2.WithUnmarshalers"}}({{ref "encoding/json/v2.JoinUnmarshalers"}}(
            {{range .Fields -}}
            {{if and .NeedsMarshaling (not .IsEmbedded) -}}
            {{ref "encoding/json/v2.UnmarshalFromFunc"}}(_octoqlUnmarshal{{.GoType.Unwrap.QualifiedRef}}),
            {{end -}}
            {{end -}}
        )),
        {{end -}}
    )
    {{else -}}
    b, err := dec.ReadValue()
    if err != nil {
        return err
    }
    if string(b) == "null" {
        return nil
    }

    {{if $hasNonEmbedded -}}
    var firstPass struct{
        {{range .Fields -}}
        {{if not .IsEmbedded -}}
        {{.GoName}} {{typeRef .GoType}} `json:"{{.JSONName}}{{if .Omitempty -}},omitempty{{end}}"`
        {{end -}}
        {{end -}}
    }
    {{range .Fields -}}
    {{if not .IsEmbedded -}}
    firstPass.{{.GoName}} = v.{{.GoName}}
    {{end -}}
    {{end -}}

    err = {{ref "encoding/json/v2.Unmarshal"}}(
        b,
        &firstPass,
        dec.Options(),
        {{if $hasInterfaces -}}
        {{ref "encoding/json/v2.WithUnmarshalers"}}({{ref "encoding/json/v2.JoinUnmarshalers"}}(
            {{range .Fields -}}
            {{if and .NeedsMarshaling (not .IsEmbedded) -}}
            {{ref "encoding/json/v2.UnmarshalFromFunc"}}(_octoqlUnmarshal{{.GoType.Unwrap.QualifiedRef}}),
            {{end -}}
            {{end -}}
        )),
        {{end -}}
    )
    if err != nil {
        return err
    }
    {{range .Fields -}}
    {{if not .IsEmbedded -}}
    v.{{.GoName}} = firstPass.{{.GoName}}
    {{end -}}
    {{end -}}
    {{end -}}

    {{range $field := .Fields -}}
    {{if $field.IsEmbedded -}}
    err = {{ref "encoding/json/v2.Unmarshal"}}(
        b, &v.{{typeRef $field.GoType.Unwrap}}, dec.Options())
    if err != nil {
        return err
    }
    {{end -}}
    {{end -}}

    return nil
    {{end -}}
}
