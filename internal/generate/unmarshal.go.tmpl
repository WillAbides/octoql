{{/* We need to generate UnmarshalJSONFrom and UnmarshalJSON methods for types
     that require custom JSON handling:
        - a struct with an embedded (anonymous) fragment field (tagged
          `json:"-"`), so every embedded fragment struct is populated even when
          fields overlap across the struct and its embeds
        - a struct with a field of a GraphQL interface or union type
     Whenever a struct requires custom unmarshaling, we also generate
     MarshalJSONTo and MarshalJSON (see marshal.go.tmpl).

     When a struct has no embedded fields, we unmarshal directly into a
     method-stripped type alias with WithUnmarshalers registered for its
     interface fields. When it has embedded fields, we first decode all
     non-embedded fields, then unmarshal the input again into each embedded
     field. */}}

func (v *{{.GoName}}) UnmarshalJSON(b []byte) error {
    return {{ref "encoding/json/v2.Unmarshal"}}(b, v)
}

func (v *{{.GoName}}) UnmarshalJSONFrom(dec *{{ref "encoding/json/jsontext.Decoder"}}) error {
    {{- $hasEmbedded := false -}}
    {{- $hasNonEmbedded := false -}}
    {{- $hasInterfaces := false -}}
    {{- range .Fields -}}
    {{- if .IsEmbedded -}}
    {{- $hasEmbedded = true -}}
    {{- else -}}
    {{- $hasNonEmbedded = true -}}
    {{- if .NeedsMarshaling -}}{{- $hasInterfaces = true -}}{{- end -}}
    {{- end -}}
    {{- end }}

    {{if not $hasEmbedded -}}
    if dec.PeekKind() == 'n' {
        _, err := dec.ReadToken()
        return err
    }

    return {{ref "encoding/json/v2.UnmarshalDecode"}}(
        dec,
        (*_octoqlPremarshal{{.GoName}})(v),
        {{if $hasInterfaces -}}
        {{ref "encoding/json/v2.WithUnmarshalers"}}({{ref "encoding/json/v2.JoinUnmarshalers"}}(
            {{range .Fields -}}
            {{if and .NeedsMarshaling (not .IsEmbedded) -}}
            {{ref "encoding/json/v2.UnmarshalFromFunc"}}(_octoqlUnmarshal{{.GoType.Unwrap.QualifiedRef}}),
            {{end -}}
            {{end -}}
        )),
        {{end -}}
    )
    {{else -}}
    b, err := dec.ReadValue()
    if err != nil {
        return err
    }
    if string(b) == "null" {
        return nil
    }

    {{if $hasNonEmbedded -}}
    var firstPass struct{
        {{range .Fields -}}
        {{if not .IsEmbedded -}}
        {{.GoName}} {{typeRef .GoType}} `json:"{{.JSONName}}{{.OmitTag}}"`
        {{end -}}
        {{end -}}
    }
    {{range .Fields -}}
    {{if not .IsEmbedded -}}
    firstPass.{{.GoName}} = v.{{.GoName}}
    {{end -}}
    {{end -}}

    err = {{ref "encoding/json/v2.Unmarshal"}}(
        b,
        &firstPass,
        dec.Options(),
        {{if $hasInterfaces -}}
        {{ref "encoding/json/v2.WithUnmarshalers"}}({{ref "encoding/json/v2.JoinUnmarshalers"}}(
            {{range .Fields -}}
            {{if and .NeedsMarshaling (not .IsEmbedded) -}}
            {{ref "encoding/json/v2.UnmarshalFromFunc"}}(_octoqlUnmarshal{{.GoType.Unwrap.QualifiedRef}}),
            {{end -}}
            {{end -}}
        )),
        {{end -}}
    )
    if err != nil {
        return err
    }
    {{range .Fields -}}
    {{if not .IsEmbedded -}}
    v.{{.GoName}} = firstPass.{{.GoName}}
    {{end -}}
    {{end -}}
    {{end -}}

    {{range $field := .Fields -}}
    {{if $field.IsEmbedded -}}
    err = {{ref "encoding/json/v2.Unmarshal"}}(
        b, &v.{{typeRef $field.GoType.Unwrap}}, dec.Options())
    if err != nil {
        return err
    }
    {{end -}}
    {{end -}}

    return nil
    {{end -}}
}
