{{/* We generate MarshalJSONTo for much the same reasons as UnmarshalJSONFrom --
     see unmarshal.go.tmpl for details.  (We generate both for generated test
     handlers and for callers who want to, for example, put octoqlgen responses
     in a cache.)

     Specifically, the treatment of field-visibility with embedded fields must
     differ from both ordinary encoding/json/v2 and unmarshaling: we need to
     choose exactly one conflicting field in all cases (whereas Go chooses at
     most one and when unmarshaling we choose them all).  See
     goStructType.FlattenedFields in types.go for more discussion of embedding
     and visibility.

     To accomplish that, we flatten out all the embedded fields when marshaling,
     following those precedence rules, and register any interface field
     marshalers via WithMarshalers so encoding/json/v2 handles arbitrary slice
     nesting directly.

     For the benefit of marshal_helper.go.tmpl, _octoqlPremarshalJSON() builds
     the flattened struct so an interface marshal helper can embed it alongside
     an explicit __typename field. */}}

{{- $hasEmbedded := false -}}
{{- range .Fields -}}
{{- if .IsEmbedded -}}{{- $hasEmbedded = true -}}{{- end -}}
{{- end -}}
{{- $hasInterfaces := false -}}
{{- range .FlattenedFields -}}
{{- if .NeedsMarshaling -}}{{- $hasInterfaces = true -}}{{- end -}}
{{- end }}

{{if $hasEmbedded -}}
type _octoqlPremarshal{{.GoName}} struct{
    {{range .FlattenedFields -}}
    {{.GoName}} {{typeRef .GoType}} `json:"{{.JSONName}}{{.OmitTag}}"`
    {{end}}
}
{{else -}}
type _octoqlPremarshal{{.GoName}} {{.GoName}}
{{end}}

func (v *{{.GoName}}) MarshalJSONTo(enc *{{ref "encoding/json/jsontext.Encoder"}}) error {
    return {{ref "encoding/json/v2.MarshalEncode"}}(
        enc,
        v._octoqlPremarshalJSON(),
        {{if $hasInterfaces -}}
        {{ref "encoding/json/v2.WithMarshalers"}}({{ref "encoding/json/v2.JoinMarshalers"}}(
            {{range .FlattenedFields -}}
            {{if .NeedsMarshaling -}}
            {{ref "encoding/json/v2.MarshalToFunc"}}(_octoqlMarshal{{.GoType.Unwrap.QualifiedRef}}),
            {{end -}}
            {{end -}}
        )),
        {{end -}}
    )
}

func (v *{{.GoName}}) _octoqlPremarshalJSON() *_octoqlPremarshal{{.GoName}} {
    {{if $hasEmbedded -}}
    var retval _octoqlPremarshal{{.GoName}}

    {{range $field := .FlattenedFields -}}
    retval.{{$field.GoName}} = v.{{$field.Selector}}
    {{end -}}

    return &retval
    {{else -}}
    return (*_octoqlPremarshal{{.GoName}})(v)
    {{end -}}
}
